const skillSpotify = `---
version: 1
name: Play a Song
app: Spotify (macOS)
tags: ["spotify", "macos", "music", "multi-target"]
---

Search for a song on the Spotify macOS app and play it.

## Steps

1. Switch to target "spotify"
2. Tap "Search"
3. Wait for "What do you want to listen to?" to appear
4. Type "\${SONG:-Bohemian Rhapsody}"
5. Wait for "\${SONG:-Bohemian Rhapsody}" to appear
6. Tap "\${SONG:-Bohemian Rhapsody}"
7. Verify "Playing" is visible
8. Screenshot: "now_playing"`;

const skillsRepo = "jfarcand/mirroir-skills";
const skillsBase = `https://github.com/${skillsRepo}`;
const rawBase = `https://raw.githubusercontent.com/${skillsRepo}/main`;

interface Skill {
  name: string;
  description: string;
  app: string;
  path: string;
  category: string;
  url: string;
  rawUrl: string;
}

// Read pre-generated skills index from filesystem (produced by scripts/generate-skills-index.mjs).
// Falls back to GitHub API if the file doesn't exist, and to an empty list on error.
const indexPath = resolve(process.cwd(), "src/data/skills-index.json");
let skills: Skill[] = [];
let skillsAvailable = false;

if (existsSync(indexPath)) {
  try {
    skills = JSON.parse(readFileSync(indexPath, "utf-8"));
    skillsAvailable = skills.length > 0;
  } catch {
    // Corrupted file — continue with empty list
  }
}

if (!skillsAvailable) {
  // Fallback: fetch from GitHub API at build time (rate-limited)
  const ghHeaders: Record<string, string> = {
    Accept: "application/vnd.github.v3+json",
  };
  const ghToken = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;
  if (ghToken) {
    ghHeaders.Authorization = `Bearer ${ghToken}`;
  }

  try {
    const treeRes = await fetch(
      `https://api.github.com/repos/${skillsRepo}/git/trees/main?recursive=1`,
      { headers: ghHeaders }
    );
    const tree = await treeRes.json();
    // Canonical corpus: Agent-Skills SKILL.md files under skills/. Excludes
    // legacy *.yaml, archetypes/, and .github/ CI workflows.
    const skillFiles = (tree.tree ?? []).filter(
      (f: { path: string }) => f.path.startsWith("skills/") && f.path.endsWith(".md")
    );

    function frontmatterField(content: string, key: string): string {
      const fm = content.match(/^---\n([\s\S]*?)\n---/);
      const block = fm ? fm[1] : content;
      const m = block.match(new RegExp(`^${key}:\\s*(.+)$`, "m"));
      return m ? m[1].trim() : "";
    }

    function descriptionField(content: string): string {
      const body = content.replace(/^---\n[\s\S]*?\n---\n?/, "");
      const para: string[] = [];
      for (const line of body.split("\n")) {
        const trimmed = line.trim();
        if (trimmed === "") {
          if (para.length > 0) break;
          continue;
        }
        if (trimmed.startsWith("#")) break;
        para.push(trimmed);
      }
      return para.join(" ");
    }

    const fetches = skillFiles.map(async (f: { path: string }) => {
      const res = await fetch(
        `https://api.github.com/repos/${skillsRepo}/contents/${f.path}`,
        { headers: ghHeaders }
      );
      const data = await res.json();
      // Decode base64 as UTF-8 (atob yields latin1 → mojibake on accents).
      const content = Buffer.from(data.content, "base64").toString("utf-8");
      const parts = f.path.split("/");
      // Drop the leading `skills/` segment from the displayed category.
      const category = parts.slice(1, -1).join("/");
      return {
        name: frontmatterField(content, "name") || f.path,
        description: descriptionField(content),
        app: frontmatterField(content, "app"),
        path: f.path,
        category,
        url: `${skillsBase}/blob/main/${f.path}`,
        rawUrl: `${rawBase}/${f.path}`,
      };
    });
    skills = await Promise.all(fetches);
    skillsAvailable = skills.length > 0;
  } catch {
    // Build continues with empty list if GitHub API is unreachable
  }
}

// A <script> element holds raw text, so the JSON goes in unescaped (set:html):
// HTML entities would reach JSON.parse literally. Escaping "<" keeps a skill
// description containing "</script>" from closing the element early.
const skillsJson = JSON.stringify(skills).replace(/</g, "\\u003c");

---

<Layout
  title="mirroir-mcp: real iPhone automation for AI agents over MCP"
  description="Let your AI agent use your real iPhone over MCP, with no Developer Mode, Xcode or WebDriverAgent. Automate any app, then replay the flow in CI without an LLM."
  softwareVersion={version}
>
  <!-- Hero -->
  <header>
    <img src={`${import.meta.env.BASE_URL}mirroir-wordmark.svg`} alt="mirroir-mcp logo" class="logo" width="80" height="100" />
    <h1>mirroir-mcp</h1>
    <p class="tagline">
      Let your agent use your real iPhone, then replay what it did without an LLM.
    </p>
    <p class="subtitle">
      iPhone automation for AI agents: drive a real, stock iPhone from any MCP client, with <strong>no Developer Mode, no Xcode, no WebDriverAgent and no jailbreak</strong>. It works through macOS iPhone Mirroring, so it reaches any app on your phone, including App Store apps you could never build. It uses the apps already signed in on your phone: no connector, no OAuth, no password handed to anyone.
    </p>
    <div class="hero-cta">
      <a class="btn-primary" href="#demo">Watch the demo</a>
      <a class="btn-secondary" href="#install">Install</a>
      <a class="btn-secondary" href="https://github.com/jfarcand/mirroir-mcp" rel="noopener noreferrer">View on GitHub</a>
    </div>
    <p class="hero-requirements">
      Needs macOS 15 or later and an iPhone connected through <a href="https://support.apple.com/en-us/120421" rel="noopener noreferrer">iPhone Mirroring</a>.
    </p>
    <pre class="snippet hero-flow"><code>{agentFlow}</code></pre>
  </header>

  <main>
  <!-- Demo Videos -->
  <section class="demo-section" id="demo">
    <h2>Real runs on a real iPhone</h2>
    <div class="carousel demo-carousel">
      <div class="carousel-track">
        <div class="carousel-slide demo-slide">
          <h3>Recipe reel to grocery list</h3>
          <video class="demo-wide" loop muted playsinline preload="metadata" tabindex="0" poster={`${import.meta.env.BASE_URL}recipe-grocery-list.poster.jpg`} aria-label="The console and a real iPhone side by side: the agent opens a saved Instagram recipe reel, listens to it, then writes a ten-item grocery list in Reminders">
            <source src={`${import.meta.env.BASE_URL}recipe-grocery-list.mp4`} type="video/mp4" />
          </video>
          <p class="demo-caption">A saved recipe reel becomes a grocery list in Reminders. The agent listens to the video and reads its frames. Sped up.</p>
        </div>
        <div class="carousel-slide demo-slide">
          <h3>Cross-app errand</h3>
          <video class="demo-wide" loop muted playsinline preload="none" tabindex="0" poster={`${import.meta.env.BASE_URL}video2-waze-slack.poster.jpg`} aria-label="An AI agent reads the commute time in Waze on a real iPhone, then posts it in Slack">
            <source src={`${import.meta.env.BASE_URL}video2-waze-slack.mp4`} type="video/mp4" />
          </video>
          <p class="demo-caption">Sped up. The agent reads the ETA in Waze, then posts it in Slack.</p>
        </div>
        <div class="carousel-slide demo-slide">
          <h3>Chess against the strongest bot</h3>
          <video class="demo-wide" loop muted playsinline preload="none" tabindex="0" poster={`${import.meta.env.BASE_URL}chess-vs-maximum.poster.jpg`} aria-label="The console and a real iPhone side by side during a full chess game: each move is logged as it is played, ending in checkmate against the Maximum bot on Chess.com">
            <source src={`${import.meta.env.BASE_URL}chess-vs-maximum.mp4`} type="video/mp4" />
          </video>
          <p class="demo-caption">A vision model reads the board, Stockfish picks the moves, and mirroir plays them against Chess.com's Maximum bot. The opening runs at 2.5&times;, the middle game at 45&times;, the finish at 2&times;.</p>
        </div>
        <div class="carousel-slide demo-slide">
          <h3>Login flow</h3>
          <video loop muted playsinline preload="none" tabindex="0" poster={`${import.meta.env.BASE_URL}video1-expo-login.poster.jpg`} aria-label="An AI agent tests a login screen in Expo Go on a real iPhone">
            <source src={`${import.meta.env.BASE_URL}video1-expo-login.mp4`} type="video/mp4" />
          </video>
          <p class="demo-caption">Sped up. An agent tests a login screen in Expo Go.</p>
        </div>
      </div>
      <button class="carousel-prev" aria-label="Previous">&#8249;</button>
      <button class="carousel-next" aria-label="Next">&#8250;</button>
      <div class="carousel-dots"></div>
    </div>
    <div class="demo-lightbox" id="demo-lightbox" role="dialog" aria-label="Video lightbox" aria-modal="true">
      <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
      <video loop muted playsinline id="demo-lightbox-video"></video>
    </div>
    <script>
      // A demo plays only while at least this share of it is on screen, so the
      // slides scrolled out of the carousel neither download nor run.
      const PLAYING_VISIBLE_RATIO = 0.5;
      const demoVideos = Array.from(document.querySelectorAll(".demo-slide video")) as HTMLVideoElement[];

      // Autoplay videos only when reduced-motion is not preferred
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReducedMotion) {
        const playback = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const vid = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) {
                vid.play().catch(() => {});
              } else {
                vid.pause();
              }
            });
          },
          { threshold: PLAYING_VISIBLE_RATIO }
        );
        demoVideos.forEach((vid) => playback.observe(vid));
      }

      const lightbox = document.getElementById("demo-lightbox")!;
      const lbVideo = document.getElementById("demo-lightbox-video")! as HTMLVideoElement;
      const lbClose = lightbox.querySelector(".lightbox-close")! as HTMLButtonElement;
      let triggerElement: HTMLElement | null = null;

      function openLightbox(src: string, trigger: HTMLElement) {
        triggerElement = trigger;
        lbVideo.innerHTML = "";
        const source = document.createElement("source");
        source.src = src;
        source.type = "video/mp4";
        lbVideo.appendChild(source);
        lbVideo.load();
        lbVideo.play();
        lightbox.classList.add("active");
        document.documentElement.classList.add("scroll-lock");
        lbClose.focus();
      }

      function closeLightbox() {
        lightbox.classList.remove("active");
        document.documentElement.classList.remove("scroll-lock");
        lbVideo.pause();
        if (triggerElement) {
          triggerElement.focus();
          triggerElement = null;
        }
      }

      demoVideos.forEach((vid) => {
        const open = () => openLightbox(vid.querySelector("source")!.src, vid);
        vid.addEventListener("click", open);
        // The video is the lightbox's only trigger, so it answers the keyboard too.
        vid.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open();
          }
        });
      });

      lbClose.addEventListener("click", closeLightbox);

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (!lightbox.classList.contains("active")) return;
        if (e.key === "Escape") {
          closeLightbox();
        }
        // Focus trap: cycle between close button and video
        if (e.key === "Tab") {
          const focusable = [lbClose, lbVideo];
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    </script>
  </section>

  <!-- Star banner -->
  <a class="star-banner" href="https://github.com/jfarcand/mirroir-mcp" rel="noopener noreferrer">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
    </svg>
    <span>Like mirroir-mcp? <strong>Star us on GitHub</strong> &#9733;</span>
  </a>

  <!-- Install -->
  <section id="install">
    <h2>Install mirroir-mcp <span class="version-badge">v{version}</span></h2>
    <p class="alt-install">The fastest path: paste this into your coding agent (Claude Code, Codex, Cursor, &hellip;) and let it do the setup.</p>
    <div class="install-block">
      <code>{setupPrompt}</code>
      <button class="copy-btn" data-copy={setupPrompt}>Copy</button>
    </div>
    <p class="alt-install">Or install it yourself:</p>
    <div class="install-block">
      <code><span class="prompt">$</span> {brewCmd}</code>
      <button class="copy-btn" data-copy={brewCmd}>Copy</button>
    </div>
    <p class="alt-install">
      or via <a href="https://www.npmjs.com/package/mirroir-mcp" rel="noopener noreferrer">npx</a>:
    </p>
    <div class="install-block install-block-alt">
      <code><span class="prompt">$</span> {npxCmd}</code>
      <button class="copy-btn" data-copy={npxCmd}>Copy</button>
    </div>
    <p class="alt-install">
      or via <a href="https://mirroir.dev/get-mirroir.sh" rel="noopener noreferrer">shell script</a>:
    </p>
    <div class="install-block install-block-alt">
      <code><span class="prompt">$</span> {curlCmd}</code>
      <button class="copy-btn" data-copy={curlCmd}>Copy</button>
    </div>
    <p class="alt-install">
      or as a <a href="https://docs.claude.com/en/docs/claude-code/plugins" rel="noopener noreferrer">Claude Code plugin</a>:
    </p>
    <div class="install-block install-block-alt">
      <code><span class="prompt">$</span> {pluginCmd}</code>
      <button class="copy-btn" data-copy={pluginCmd}>Copy</button>
    </div>
    <p class="alt-install">
      or as a <a href="https://github.com/NousResearch/hermes-agent" rel="noopener noreferrer">Hermes Agent</a> plugin (Hermes 0.21.6 or later), which asks before every call that can change the phone:
    </p>
    <div class="install-block install-block-alt">
      <code><span class="prompt">$</span> {hermesCmd}</code>
      <button class="copy-btn" data-copy={hermesCmd}>Copy</button>
    </div>
    <p class="alt-install">
      or, for Claude Desktop, download <code>mirroir-mcp.mcpb</code> from the <a href="https://github.com/jfarcand/mirroir-mcp/releases/latest" rel="noopener noreferrer">latest release</a> (v0.43.0 and later) and double-click it.
    </p>
  </section>

  <!-- Just tell your AI -->
  <section>
    <h2>Ask your agent</h2>
    <p>Paste any of these into Claude Code, ChatGPT, Cursor, or any MCP client.</p>

    <div class="example-cards">
      <div class="example-card">
        <p class="example-prompt">"Open Calendar, create a Dentist event next Tuesday at 2pm"</p>
        <p class="example-steps">The AI launches Calendar, taps "+", fills in title, date, and time, then saves. Handles confirmation dialogs automatically.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">"Open Messages, find Alice, and send 'running 10 min late'"</p>
        <p class="example-steps">The AI opens Messages, scrolls to find Alice's conversation, taps the text field, types the message, and hits Send.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">"Test the login screen with test@example.com / password123"</p>
        <p class="example-steps">The AI opens the app, taps Email, types the address, taps Password, types it, taps Sign In, and screenshots the result.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">"Start recording, open Instagram, scroll the feed and open my profile, stop recording"</p>
        <p class="example-steps">The AI starts a video capture, scrolls through the Instagram feed, taps the profile tab, then stops recording and returns the file path.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section>
    <h2>How it works</h2>
    <p>Every interaction follows the same loop &mdash; observe, reason, act.</p>

    <div class="agent-loop">
      <div class="agent-loop-step">
        <div class="agent-loop-icon">&#x1F441;</div>
        <h3>Eyes</h3>
        <p><code>describe_screen</code> returns every text element on the iPhone screen with exact tap coordinates.</p>
      </div>
      <div class="agent-loop-step">
        <div class="agent-loop-icon">&#x1F9E0;</div>
        <h3>Brain</h3>
        <p>Your LLM reads the screen, decides what to do next, and picks the right tool.</p>
      </div>
      <div class="agent-loop-step">
        <div class="agent-loop-icon">&#x270B;</div>
        <h3>Hands</h3>
        <p><code>tap</code>, <code>type_text</code>, <code>swipe</code> &mdash; the AI executes the action, then loops back to observe.</p>
      </div>
    </div>

    <div class="agent-walkthrough">
      You say <em>"send Alice a message."</em> The AI screenshots the phone, reads the screen via OCR, taps Messages, finds Alice's conversation, types your message, and hits Send.
    </div>
  </section>

  <!-- Why mirroir -->
  <section id="why">
    <h2>Why mirroir</h2>
    <div class="example-cards">
      <div class="example-card">
        <p class="example-prompt">Your apps, already signed in</p>
        <p class="example-steps">mirroir uses the apps already signed in on your phone: no connector, no OAuth, no password handed to anyone. If you can open it on the phone, your agent can use it.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">Nothing to install on the phone</p>
        <p class="example-steps">The iPhone stays stock: no signing, no provisioning profile, no on-device agent. If iPhone Mirroring shows it, mirroir can drive it.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">Your Mac stays yours</p>
        <p class="example-steps">Taps, typing and swipes reach the mirror without bringing it to the front, so you can keep working. Drags and two-finger gestures bring it forward for a moment, then hand your app back.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">Explore once, replay without an LLM</p>
        <p class="example-steps"><code>generate_skill</code> explores an app and writes SKILL.md files. A compiled skill replays from the CLI with no AI in the loop, so CI runs are deterministic and cost no tokens.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">Drift fails loudly</p>
        <p class="example-steps"><code>mirroir-run</code> has a third verdict beside pass and fail: <code>DRIFT</code>, exit code 65, when every assertion held but the output moved past its baseline.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">One scenario, many surfaces</p>
        <p class="example-steps">A single scenario can drive the iPhone, a browser (Playwright), HTTP endpoints and subprocesses, then compare what the page and the phone showed.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">It plays games, too</p>
        <p class="example-steps">A <code>scene:</code> step plays a turn-based or tap-driven game, frame by frame, under a hard budget. <a href="#games">See how</a>.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">It hears the phone, too</p>
        <p class="example-steps"><code>listen</code> turns what the phone plays, a reel's narration or a voice message, into text. Only iPhone Mirroring's sound is recorded, and macOS transcribes it on the Mac: the audio never leaves it. Needs macOS 26; since 0.47.0.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">An agent on another machine</p>
        <p class="example-steps"><code>mirroir-mcp serve</code> speaks MCP over HTTP on 127.0.0.1 only, behind a bearer token; reach it through an SSH port forward. <code>install-agent</code> runs it as a LaunchAgent from its own signed "mirroir serve" app, so its grants survive upgrades. <a href={`${import.meta.env.BASE_URL}docs/#serve`}>Set it up</a>.</p>
      </div>
      <div class="example-card">
        <p class="example-prompt">Agents keep notes</p>
        <p class="example-steps"><code>save_note</code> keeps one line per lesson per app, and <code>get_notes</code> hands it to the next session, so it starts with what the last one learned.</p>
      </div>
    </div>

    <h3 class="compare-title">How it compares</h3>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th>mirroir</th>
            <th><a href="https://github.com/phone-harness/phone-harness" rel="noopener noreferrer">phone-harness</a></th>
            <th><a href="https://github.com/mobile-next/mobile-mcp" rel="noopener noreferrer">mobile-mcp</a></th>
            <th><a href="https://github.com/appium/appium" rel="noopener noreferrer">Appium</a></th>
          </tr>
        </thead>
        <tbody>
          <tr><th>Physical iPhone, no Developer Mode or signing</th><td>Yes &mdash; stock phone via iPhone Mirroring</td><td>Yes &mdash; stock phone via iPhone Mirroring</td><td>USB-connected, trusted device</td><td>No &mdash; WebDriverAgent via Xcode, Developer Mode</td></tr>
          <tr><th>App Store apps you can't build</th><td>Yes</td><td>Yes</td><td>Yes</td><td>Yes, on a provisioned device</td></tr>
          <tr><th>Your own iPhone from any MCP client</th><td>Yes</td><td>No &mdash; its MCP server is cloud-only; local phones use its CLI</td><td>Yes</td><td>Through the separate <a href="https://github.com/appium/appium-mcp" rel="noopener noreferrer">appium-mcp</a></td></tr>
          <tr><th>Replay without an LLM</th><td>Yes &mdash; compiled skills</td><td>Python scripts you write; no recorder or compiled replay</td><td>No &mdash; the agent drives every run</td><td>Yes &mdash; test code</td></tr>
          <tr><th>Distinct drift verdict</th><td>Yes &mdash; <code>DRIFT</code>, exit 65</td><td>No</td><td>No</td><td>No</td></tr>
          <tr><th>One scenario across iPhone + web + HTTP</th><td>Yes &mdash; <code>mirroir-run</code></td><td>No</td><td>No</td><td>Via your own test code</td></tr>
          <tr><th>Android</th><td>No</td><td>Yes</td><td>Yes</td><td>Yes</td></tr>
          <tr><th>iOS Simulator</th><td>No</td><td>No</td><td>Yes</td><td>Yes</td></tr>
          <tr><th>Hosted cloud phones</th><td>No</td><td>Yes &mdash; Phone Harness Cloud</td><td>Yes &mdash; Mobile Next Cloud</td><td>Via third-party device clouds</td></tr>
        </tbody>
      </table>
    </div>
    <p>phone-harness is the closest tool here: it also drives a stock iPhone through iPhone Mirroring, and it adds Android and hosted phones, which mirroir doesn't have. mobile-mcp and Appium cover Android and simulators too. mirroir goes further after the agent's first run: that run becomes a replay that needs no LLM, and a test that tells you when the output moves.</p>
  </section>

  <!-- Security -->
  <section>
    <h2>Safety</h2>
    <p>
      Giving an AI access to your phone demands defense in depth, so mirroir-mcp is fail-closed.
    </p>

    <div class="security-grid">
      <div class="security-layer">
        <h3>Tool permissions</h3>
        <p>Without a config file, only the 14 read-only tools (<code>screenshot</code>, <code>describe_screen</code>, <code>status</code>, <code>list_skills</code>, &hellip;) are exposed. Mutating tools are hidden from the MCP client entirely &mdash; it never sees them.</p>
      </div>
      <div class="security-layer">
        <h3>App blocking</h3>
        <p><code>blockedApps</code> in <code>permissions.json</code> prevents the AI from interacting with sensitive apps like Wallet or Banking &mdash; even if mutating tools are allowed.</p>
      </div>
      <div class="security-layer">
        <h3>No root, no daemon</h3>
        <p>Runs as your user with Screen Recording and Accessibility permissions, and lives and dies with your MCP client. No kernel extensions, no root privileges; the only thing that keeps running is the <code>serve</code> agent, if you install it.</p>
      </div>
    </div>

    <Code code={permissionsCode} lang="json" theme="github-dark" />

    <p>
      Drop this in <code>~/.mirroir-mcp/permissions.json</code> to control
      exactly which tools your AI agent can use. Quit iPhone Mirroring, unlock the iPhone or lock the Mac to stop all input instantly.
    </p>
  </section>

  <!-- Skills -->
  <section id="skills">
    <h2>Repeatable flows: Skills</h2>
    <p>
      When you find yourself repeating the same agent workflow, capture it as a skill. Skills are SKILL.md files &mdash; numbered steps the AI follows, adapting to layout changes and unexpected dialogs.
      Steps like <code>Tap "Email"</code> use OCR, not coordinates.
      Share them on the <a href="https://github.com/jfarcand/mirroir-skills" rel="noopener noreferrer">community repository</a>.
    </p>

    <div class="carousel skill-carousel">
      <div class="carousel-track">
        <div class="carousel-slide skill-slide">
          <h3>Branching + looping</h3>
          <Code code={skillExpo} lang="markdown" theme="github-dark" />
        </div>
        <div class="carousel-slide skill-slide">
          <h3>Cross-app workflow</h3>
          <Code code={skillWaze} lang="markdown" theme="github-dark" />
        </div>
        <div class="carousel-slide skill-slide">
          <h3>macOS window (experimental)</h3>
          <Code code={skillSpotify} lang="markdown" theme="github-dark" />
        </div>
      </div>
      <button class="carousel-prev" aria-label="Previous">&#8249;</button>
      <button class="carousel-next" aria-label="Next">&#8250;</button>
      <div class="carousel-dots"></div>
    </div>

    <h2>Community skill library</h2>
    <p>
      The <a href="https://github.com/jfarcand/mirroir-skills" rel="noopener noreferrer">mirroir-skills</a> repository
      is an open collection of ready-made SKILL.md files &mdash; login flows, cross-app workflows, settings automation, and more.
      <code>$&#123;VAR&#125;</code> placeholders resolve from environment variables, so the same skill works across accounts and devices.
    </p>
    <p>
      Install the full library as a Claude Code plugin<sup>*</sup>:
    </p>
    <div class="install-block install-block-alt">
      <code><span class="prompt">$</span> claude plugin marketplace add jfarcand/mirroir-mcp &amp;&amp; claude plugin install skills@mirroir</code>
      <button class="copy-btn" data-copy="claude plugin marketplace add jfarcand/mirroir-mcp &amp;&amp; claude plugin install skills@mirroir">Copy</button>
    </div>
    <p class="install-hint">
      <sup>*</sup> Also supported by GitHub Copilot.
    </p>
    <div class="skill-search-wrap">
      <input
        type="text"
        id="skill-q"
        placeholder="Search skills... (e.g. login, slack, calendar)"
        autocomplete="off"
      />
      <ul id="skill-results"></ul>
    </div>
    <script id="skill-data" type="application/json" set:html={skillsJson} />
    <script define:vars={{ skillsAvailable }}>
      const skills = JSON.parse(
        document.getElementById("skill-data").textContent ?? "[]"
      );
      const indexAvailable = skillsAvailable;
      const input = document.getElementById("skill-q");
      const results = document.getElementById("skill-results");

      function clearResults() {
        while (results.firstChild) {
          results.removeChild(results.firstChild);
        }
      }

      function showStatus(message) {
        clearResults();
        const li = document.createElement("li");
        li.className = "skill-status";
        li.textContent = message;
        results.appendChild(li);
      }

      function render(matches) {
        clearResults();
        if (!indexAvailable) {
          showStatus("Skill index unavailable — try again later.");
          return;
        }
        if (!matches.length) {
          showStatus("No matching skills.");
          return;
        }
        for (const s of matches) {
          const li = document.createElement("li");

          const row = document.createElement("div");
          row.className = "skill-row";

          const nameLink = document.createElement("a");
          nameLink.href = s.url;
          nameLink.target = "_blank";
          nameLink.rel = "noopener noreferrer";
          nameLink.textContent = s.name;
          row.appendChild(nameLink);

          const appBadge = document.createElement("span");
          appBadge.className = "skill-app";
          appBadge.textContent = s.app;
          row.appendChild(appBadge);

          const dlLink = document.createElement("a");
          dlLink.className = "skill-dl";
          dlLink.href = s.rawUrl;
          dlLink.download = "";
          dlLink.title = "Download skill";
          dlLink.textContent = "\u2193";
          dlLink.rel = "noopener noreferrer";
          row.appendChild(dlLink);

          li.appendChild(row);

          if (s.description) {
            const desc = document.createElement("span");
            desc.className = "skill-desc";
            desc.textContent = s.description;
            li.appendChild(desc);
          }

          results.appendChild(li);
        }
      }

      input.addEventListener("input", () => {
        const q = input.value.toLowerCase().trim();
        if (!q) {
          clearResults();
          return;
        }
        const matches = skills.filter(
          (s) =>
            s.name.toLowerCase().includes(q) ||
            s.description.toLowerCase().includes(q) ||
            s.app.toLowerCase().includes(q) ||
            s.category.toLowerCase().includes(q)
        );
        render(matches);
      });
    </script>
  </section>

  <!-- From exploration to CI -->
  <section>
    <h2>From exploration to CI</h2>
    <p>
      When you need repeatable tests, mirroir takes you from a first exploration to CI. Point it at an app: it explores the screens it can reach, breadth-first, then writes a bundle of SKILL.md files. Pair it with an <code>APP.md</code> map for guided exploration. Edit the skills, test them from the CLI, diagnose failures with <code>--agent</code>.
    </p>

    <div class="pipeline-grid">
      <div class="pipeline-step">
        <div class="pipeline-icon">1</div>
        <h3>Generate</h3>
        <p>A single <code>generate_skill(action: "explore")</code> call explores each screen breadth-first, replays paths to reach child screens, and builds a navigation graph of what it reached. Pass <code>explorer: "dfs"</code> for depth-first instead.</p>
        <div class="pipeline-cmd">
          <code>generate_skill(action: "explore", app_name: "Weather")</code>
        </div>
      </div>
      <div class="pipeline-step">
        <div class="pipeline-icon">2</div>
        <h3>Write</h3>
        <p>Edit the generated skill or author one from scratch &mdash; numbered steps, no coordinates.</p>
        <div class="pipeline-cmd">
          <code>vim login.md</code>
        </div>
      </div>
      <div class="pipeline-step">
        <div class="pipeline-icon">3</div>
        <h3>Run</h3>
        <p>The AI reads the skill via <code>get_skill</code>, executes each step with MCP tools, records each one with <code>record_step</code>, and saves the coordinates with <code>save_compiled</code>.</p>
        <div class="pipeline-cmd">
          <code>get_skill &rarr; record_step &rarr; save_compiled</code>
        </div>
      </div>
      <div class="pipeline-step">
        <div class="pipeline-icon">4</div>
        <h3>Test</h3>
        <p>Replay without AI from recorded coordinates &mdash; and every step is still checked: a button that moved is found, one that is gone fails the run.</p>
        <div class="pipeline-cmd">
          <code>mirroir test login</code>
        </div>
      </div>
      <div class="pipeline-step">
        <div class="pipeline-icon">5</div>
        <h3>Diagnose</h3>
        <p>When a step fails, <code>--agent</code> compares expected vs. actual OCR and tells you the root cause and fix.</p>
        <div class="pipeline-cmd">
          <code>mirroir test --agent claude-sonnet-5-5 login</code>
        </div>
      </div>
    </div>

    <p>
      Agent diagnosis runs in two tiers: deterministic OCR analysis first (free, no API key), then optionally an AI model for richer analysis.
      Supports <a href="https://github.com/jfarcand/mirroir-mcp#ai-assisted-diagnosis" rel="noopener noreferrer">Anthropic, OpenAI, local Ollama, embacle, and CLI agents</a>.
    </p>
  </section>

  <!-- Describe your app -->
  <section>
    <h2>Describe your app with APP.md</h2>
    <p>
      mirroir can explore any iOS app blindly &mdash; but it works best when you tell it what to expect. Drop an <code>APP.md</code> file in <code>~/.mirroir-mcp/skills/</code> (or the community <a href="https://github.com/jfarcand/mirroir-skills/tree/main/patterns/apps" rel="noopener noreferrer">patterns/apps</a> folder) and mirroir gets a map before it starts.
    </p>

    <div class="appmd-grid">
      <div class="appmd-code">
        <Code code={appMdExample} lang="markdown" theme="github-dark" />
      </div>
      <div class="appmd-features">
        <div class="appmd-feature">
          <h3>Archetype</h3>
          <p><code>dashboard</code>, <code>social-feed</code>, <code>settings-list</code>, and more &mdash; tells mirroir how the app navigates so exploration uses the right strategy.</p>
        </div>
        <div class="appmd-feature">
          <h3>Structure &amp; tabs</h3>
          <p>Tab names become priority targets when component detection misses non-standard UIs. Section descriptions flow into AI context for generated skills.</p>
        </div>
        <div class="appmd-feature">
          <h3>Obstacles</h3>
          <p>Permission prompts, onboarding sheets, rating dialogs &mdash; declared once, dismissed automatically every time they appear.</p>
        </div>
        <div class="appmd-feature">
          <h3>Skip list</h3>
          <p>Destructive actions like &ldquo;Delete account&rdquo; or &ldquo;Reset&rdquo; are never tapped during autonomous exploration.</p>
        </div>
      </div>
    </div>

    <p class="appmd-hint">
      Three levels of patterns work together &mdash; <strong>elements</strong> (what rows look like), <strong>screens</strong> (what the page layout means), and <strong>apps</strong> (what the developer knows). 30 seconds of writing saves minutes of blind exploration.
    </p>
  </section>

  <!-- mirroir-run: cross-platform replay -->
  <section id="mirroir-run">
    <h2>Replay anywhere with <code>mirroir-run</code></h2>
    <p>
      <strong>mirroir-run</strong> replays the same scenarios beyond the iPhone: web pages through Playwright (Chromium, Firefox, WebKit), processes and HTTP natively, and iOS blocks through <code>mirroir-mcp</code>. One YAML file can drive a browser and a phone and check that they show the same thing &mdash; and its web, process, and HTTP steps run on Linux CI.
    </p>
    <p>
      <a href={`${import.meta.env.BASE_URL}docs/#mirroir-run`}>Commands, install, GitHub Actions and Maestro import</a>
    </p>
  </section>

  <!-- Games -->
  <section id="games">
    <h2>It plays games, too</h2>
    <p>
      A <a href="https://github.com/jfarcand/mirroir-mcp/blob/main/docs/games.md" rel="noopener noreferrer"><code>scene:</code> step</a> plays a turn-based or tap-driven game, frame by frame, until the game is won or lost or its budget of frames, tokens or time runs out. A run that exhausts its budget is inconclusive (exit 66), never a silent pass.
    </p>
    <p>
      The chess game above is one of these runs. A vision model reads the board, Stockfish picks each move, and mirroir plays it on a stock iPhone. It beat Chess.com's Maximum bot (3200) in 65 frames and about 166,000 tokens.
    </p>
    <p>
      Menus, shops and win screens are ordinary UI that skills already drive. iPhone Mirroring exposes a single pointer, so twin-stick and twitch games stay out of reach.
    </p>
  </section>

  <!-- What it does -->
  <section>
    <h2>What mirroir-mcp can do</h2>
    <p>
      42 tools exposed as an MCP server: touch, typing, screen reading, navigation and skills.
      <a href={`${import.meta.env.BASE_URL}docs/#tools`}>See every tool</a>.
    </p>
  </section>

  <!-- FAQ -->
  <section>
    <h2>FAQ</h2>
    <div class="faq-list">
      <details>
        <summary>Is this safe? Can the AI access my banking apps?</summary>
        <p>Without a config file, only read-only tools are exposed. Mutating tools require explicit opt-in. Use <code>blockedApps</code> in <code>permissions.json</code> to deny access to sensitive apps. Quitting iPhone Mirroring, unlocking the iPhone, locking the Mac's screen, or quitting your MCP client stops all input at once.</p>
      </details>
      <details>
        <summary>Will it take over my Mac while it works?</summary>
        <p>Not for most actions. Taps, typing and swipes reach the mirror without bringing it to the front, so you can keep working. Drags and two-finger gestures bring it forward for a moment, then hand your app back.</p>
      </details>
      <details>
        <summary>Does it work with any iPhone app?</summary>
        <p>Yes. It works at the screen level through iPhone Mirroring, with no source code, SDK or jailbreak. If you can see it on screen, your agent can interact with it.</p>
      </details>
      <details>
        <summary>How is it different from phone-harness or Appium?</summary>
        <p>phone-harness also drives a stock iPhone through iPhone Mirroring, and it adds Android and hosted phones. mirroir exposes your own iPhone over MCP and turns a run into a replay with no LLM and a distinct drift verdict. Appium needs WebDriverAgent built with Xcode and Developer Mode on the phone; mirroir installs and enables nothing on the device. Appium covers Android and simulators, which mirroir doesn't. Already have Maestro flows? <code>mirroir-run import maestro</code> converts them.</p>
      </details>
      <details>
        <summary>Does it need any kernel extensions or root access?</summary>
        <p>No. It runs as your user with Screen Recording and Accessibility permissions. No kernel extensions, no root privileges, and no helper daemon unless you install the opt-in <code>serve</code> agent yourself.</p>
      </details>
      <details>
        <summary>Does my phone's audio leave my Mac?</summary>
        <p>No. <code>listen</code> records only iPhone Mirroring's sound, through the Screen &amp; System Audio Recording grant mirroir already has, and macOS's own speech recognizer transcribes it on the Mac. The temporary audio file is deleted once read; your agent gets the words only. Screenshots are a different matter: what your agent sees goes to whichever model runs it.</p>
      </details>
      <details>
        <summary>Can it control macOS apps too, not just iPhone?</summary>
        <p>Experimental. You can add targets in <code>.mirroir-mcp/targets.json</code> pointing at macOS windows. The same tools work, but with limitations &mdash; both the MCP client and target window must be in the same macOS Space, and iPhone-specific tools (press_home, press_app_switcher, spotlight) don't apply. See the README for details.</p>
      </details>
      <details>
        <summary>Can I restrict which tools the AI can use?</summary>
        <p>Yes. Drop a <code>permissions.json</code> with <code>allow</code> and <code>deny</code> lists. Tools not in the allow list are hidden from the MCP client entirely.</p>
      </details>
    </div>
    <p>
      <a href="https://github.com/jfarcand/mirroir-mcp/blob/main/docs/faq.md" rel="noopener noreferrer">Read the full FAQ</a>
    </p>
  </section>

  <!-- Carousel initialization -->
  <script>
    document.querySelectorAll(".carousel").forEach((carousel) => {
      const track = carousel.querySelector(".carousel-track") as HTMLElement;
      const slides = Array.from(carousel.querySelectorAll(".carousel-slide")) as HTMLElement[];
      const prevBtn = carousel.querySelector(".carousel-prev") as HTMLButtonElement;
      const nextBtn = carousel.querySelector(".carousel-next") as HTMLButtonElement;
      const dotsContainer = carousel.querySelector(".carousel-dots")!;

      if (slides.length < 2) {
        prevBtn.style.display = "none";
        nextBtn.style.display = "none";
        dotsContainer.remove();
        return;
      }

      let currentIndex = 0;

      slides.forEach((_, i) => {
        const dot = document.createElement("button");
        dot.classList.add("carousel-dot");
        dot.setAttribute("aria-label", `Go to slide ${i + 1}`);
        if (i === 0) dot.classList.add("active");
        dot.addEventListener("click", () => goTo(i));
        dotsContainer.appendChild(dot);
      });

      function goTo(index: number) {
        currentIndex = Math.max(0, Math.min(index, slides.length - 1));
        track.scrollTo({
          left: slides[currentIndex].offsetLeft - track.offsetLeft,
          behavior: "smooth",
        });
        updateUI();
      }

      function updateUI() {
        prevBtn.disabled = currentIndex === 0;
        nextBtn.disabled = currentIndex === slides.length - 1;
        dotsContainer.querySelectorAll(".carousel-dot").forEach((dot, i) => {
          dot.classList.toggle("active", i === currentIndex);
        });
      }

      prevBtn.addEventListener("click", () => goTo(currentIndex - 1));
      nextBtn.addEventListener("click", () => goTo(currentIndex + 1));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = slides.indexOf(entry.target as HTMLElement);
              if (index >= 0) {
                currentIndex = index;
                updateUI();
              }
            }
          });
        },
        { root: track, threshold: 0.6 }
      );
      slides.forEach((slide) => observer.observe(slide));

      updateUI();
    });
  </script>
  </main>
